# Database connection URL (use a secret store for real credentials)
DATABASE_URL="postgresql://user:password@localhost:5432/ride_trends"

# --- API KEYS ---
YOUTUBE_API_KEY="your_youtube_key_here"
BSKY_HANDLE="your.handle.bsky.social"
BSKY_PASSWORD="your-app-password"

# Optional ingestion / model tuning
DEFAULT_TOPICS="AI,fitness,skincare,food,travel,personal finance"
SCRAPE_LIMIT="10"
TRAINING_THRESHOLD="50"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"
BERT_BASE_MODEL="distilbert-base-uncased"
MAX_SEQ_LENGTH="128"
